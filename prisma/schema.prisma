generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  nama      String
  plan      String   @default("trial")
  trialEnd  DateTime?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  outlets  Outlet[]
  products Product[]
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String   @unique
  name      String
  password  String
  role      String   @default("kasir")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Outlet {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nama      String
  alamat    String?
  telepon   String?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Product {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nama      String
  sku       String?
  barcode   String?
  hargaJual Int
  hargaBeli Int?
  satuan    String   @default("pcs")
  stokMin   Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId, nama])
}